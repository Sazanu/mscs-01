rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Mary Candyland is a single-school system. Any signed-in
    // user can read and write school data directly. Firebase
    // Authentication is the only gatekeeper.

    match /schools/{id} {
      allow read, write: if signedIn();
    }

    match /users/{id} {
      allow read, write: if signedIn();
    }

    match /students/{id} {
      allow read, write: if signedIn();
    }

    match /parents/{id} {
      allow read, write: if signedIn();
    }

    match /teachers/{id} {
      allow read, write: if signedIn();
    }

    match /academicYears/{id} {
      allow read, write: if signedIn();
    }

    match /terms/{id} {
      allow read, write: if signedIn();
    }

    match /classes/{id} {
      allow read, write: if signedIn();
    }

    match /subjects/{id} {
      allow read, write: if signedIn();
    }

    match /classSubjects/{id} {
      allow read, write: if signedIn();
    }

    match /studentClassHistory/{id} {
      allow read, write: if signedIn();
    }

    match /attendance/{id} {
      allow read, write: if signedIn();
    }

    match /assessments/{id} {
      allow read, write: if signedIn();
    }

    match /results/{id} {
      allow read, write: if signedIn();
    }

    match /gradingScales/{id} {
      allow read, write: if signedIn();
    }

    match /reportCards/{id} {
      allow read, write: if signedIn();
    }

    match /feeStructures/{id} {
      allow read, write: if signedIn();
    }

    match /studentFees/{id} {
      allow read, write: if signedIn();
    }

    match /payments/{id} {
      allow read, write: if signedIn();
    }

    match /receipts/{id} {
      allow read, write: if signedIn();
    }

    match /timetables/{id} {
      allow read, write: if signedIn();
    }

    match /announcements/{id} {
      allow read, write: if signedIn();
    }

    match /notifications/{id} {
      allow read, write: if signedIn();
    }

    match /documents/{id} {
      allow read, write: if signedIn();
    }

    match /auditLogs/{id} {
      allow read, write: if signedIn();
    }

    match /settings/{id} {
      allow read, write: if signedIn();
    }

    match /counters/{id} {
      allow read, write: if signedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
